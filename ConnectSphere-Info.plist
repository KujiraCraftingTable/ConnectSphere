<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<!-- Bonjour hostname của Mac dev (không đổi khi đổi mạng WiFi — macOS tự
			     advertise tên này qua mDNS trên bất kỳ LAN nào). Dùng thay cho IP
			     LAN cụ thể (hay đổi mỗi lần chuyển WiFi) — xem APIBaseURL bên dưới.
			     Kiểm tra tên hiện tại bằng `scutil --get LocalHostName`.
			     Lưu ý: mDNS bị chặn trên một số mạng công cộng/công ty có client
			     isolation — nếu vậy fallback về IP LAN qua `ipconfig getifaddr en0`
			     và thêm một entry IP riêng ở đây + APIBaseURL bên dưới như trước. -->
			<key>Tris-MacBook-Pro.local</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Cần cho request tới mạng nội bộ (mDNS/Bonjour, IP LAN) từ iOS 14+ — thiếu
	     key này iOS có thể chặn âm thầm request thay vì hiện prompt xin quyền. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>ConnectSphere cần truy cập mạng nội bộ để kết nối tới server phát triển khi test trên thiết bị thật.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Base URL của backend khi chạy trên thiết bị thật (simulator luôn dùng
	     localhost — override trong APIConfig.swift — nên không phụ thuộc dòng này).
	     Dùng hostname .local của Mac dev (ổn định qua mọi mạng WiFi) thay vì IP LAN
	     cụ thể — không cần sửa mỗi lần đổi WiFi nữa. Nếu mạng chặn mDNS, đổi tạm
	     sang IP LAN (`ipconfig getifaddr en0`) + thêm entry IP tương ứng ở
	     NSExceptionDomains bên trên. -->
	<key>APIBaseURL</key>
	<string>http://Tris-MacBook-Pro.local:3000</string>
	<!-- Google Sign-In: thay YOUR_CLIENT_ID bằng ID từ Google Cloud Console -->
	<key>GIDClientID</key>
	<string>518394941509-iitibu52ufov7mm8u570g919e0ah9nkn.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.518394941509-iitibu52ufov7mm8u570g919e0ah9nkn</string>
			</array>
		</dict>
		<!-- Custom scheme for community share links (connectsphere://community/<id>) —
		     no Universal Links: that needs a hosted domain + apple-app-site-association +
		     paid Apple Developer Associated Domains entitlement, which this project doesn't
		     have (same infra gap as APNs push, see KNOWN_GAPS.md). -->
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>connectsphere</string>
			</array>
		</dict>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ConnectSphere cần truy cập thư viện ảnh để bạn có thể đăng ảnh và video lên bài viết.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ConnectSphere cần quyền truy cập micro để bạn có thể gửi tin nhắn thoại.</string>
	<!-- Lets canOpenURL(_:) probe for the Google Maps app (comgooglemaps://) when
	     a meeting proposal's location is tapped — required since iOS 9, otherwise
	     canOpenURL always returns false and we'd silently skip straight to the
	     web fallback even when the app is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>

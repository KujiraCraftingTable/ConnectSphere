# NOTE: the localhost values for DB_HOST / REDIS_HOST / OLLAMA_URL below are for
# running the backend directly on the host. When running via `docker compose`,
# the `backend` service overrides them to DB_HOST=postgres, REDIS_HOST=redis,
# and OLLAMA_URL=http://host.docker.internal:11434, leave them as-is here.

# Server
PORT=3000
NODE_ENV=development

# Auth, REQUIRED. Generate your own: `openssl rand -hex 32`
# The server refuses to start in production without a strong value here, and
# logs a warning in dev if left as the placeholder.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=90d

# Google Sign-In, the OAuth client ID the iOS app authenticates with.
# REQUIRED for POST /api/auth/google to accept tokens: without it the server
# cannot verify the token audience and rejects Google sign-in in production.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Ollama (local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_k_m

# Redis (job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email codes (sign-up email verification, deleting a persona / the account,
# password reset), sent with the Brevo API (brevo.com. Free 300/day).
# MAIL_FROM must be a sender verified in Brevo (Senders, Domains & IPs).
# Leave BREVO_API_KEY unset in dev. The code is logged instead of emailed.
BREVO_API_KEY=xkeysib-your-brevo-api-key
MAIL_FROM=your-verified-sender@gmail.com
MAIL_FROM_NAME=ConnectSphere

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectsphere
DB_USER=connectsphere_user
DB_PASSWORD=connectsphere_pass
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# Translation pipeline (posts/comments, English <-> Vietnamese). Defaults to the
# OLLAMA_* model; point TRANSLATION_MODEL at a translation-only model later.
# TRANSLATION_URL=http://localhost:11434
# TRANSLATION_MODEL=qwen3:8b
# TRANSLATION_TIMEOUT=60
# TRANSLATION_ENABLED=1

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For; the rate
# limiter then uses that header as the client address. Leave 0 otherwise.
TRUST_PROXY=0

# Automatic content checks (Moderation/)
# shadow (default): the AI only records its verdicts and opens review cases.
# enforce: it also hides what it is sure about until a moderator decides.
# Switch only after `swift run App moderation-eval` looks right on your data.
# MODERATION_MODE=shadow
# A Qwen3Guard build on the same Ollama; `ollama pull` it first:
#   ollama pull huggingface.co/mradermacher/Qwen3Guard-Gen-4B-GGUF:Q4_K_M    (2.7 GB, default)
#   ollama pull hf.co/QuantFactory/Qwen3Guard-Gen-0.6B-GGUF:Q4_K_M            (0.5 GB, faster, less accurate)
# On the hand-made Vietnamese/English set in server/Tests/Fixtures the 4B
# wrongly flagged 0 of 90 ordinary messages and caught 92% of 108 harmful
# ones (0.6 s each); the 0.6B flagged 7 of 90 and caught 72% (0.2 s each).
# MODERATION_GUARD_MODEL=huggingface.co/mradermacher/Qwen3Guard-Gen-4B-GGUF:Q4_K_M
# Optional second opinion on text the local model is unsure about, and the only
# photo check: OpenAI's moderation endpoint is free but needs an API key.
# OPENAI_API_KEY=
# OPENAI_MODERATION_MODEL=omni-moderation-latest
